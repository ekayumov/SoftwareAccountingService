<Page x:Class="SoftwareAccountingService.Wpf.Presentation.Views.InspectionObjectFormPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Карточка объекта"
      Background="#F4F6F8">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding PageTitle}"
                   FontSize="24"
                   FontWeight="SemiBold" />

        <Grid Grid.Row="2"
              Width="650"
              HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Наименование:"
                       Margin="0,7,15,12" />
            <TextBox Grid.Row="0"
                     Grid.Column="1"
                     Height="30"
                     MaxLength="200"
                     Padding="6,3"
                     Margin="0,0,0,12"
                     IsEnabled="{Binding IsCreateMode}"
                     Text="{Binding Name,
                            UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="1"
                       Text="Версия:"
                       Margin="0,7,15,12" />
            <TextBox Grid.Row="1"
                     Grid.Column="1"
                     Height="30"
                     MaxLength="50"
                     Padding="6,3"
                     Margin="0,0,0,12"
                     IsEnabled="{Binding IsCreateMode}"
                     Text="{Binding Version,
                            UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="2"
                       Text="Тип:"
                       Margin="0,7,15,12" />
            <ComboBox Grid.Row="2"
                      Grid.Column="1"
                      Height="30"
                      Margin="0,0,0,12"
                      ItemsSource="{Binding TypeOptions}"
                      SelectedItem="{Binding SelectedType}"
                      DisplayMemberPath="DisplayName"
                      IsEnabled="{Binding IsCreateMode}" />

            <TextBlock Grid.Row="3"
                       Text="Дата получения:"
                       Margin="0,7,15,12" />
            <DatePicker Grid.Row="3"
                        Grid.Column="1"
                        Height="30"
                        Margin="0,0,0,12"
                        SelectedDate="{Binding ReceivedDate}"
                        IsEnabled="{Binding IsCreateMode}" />

            <TextBlock Grid.Row="4"
                       Text="Результат:"
                       Margin="0,7,15,12" />
            <ComboBox Grid.Row="4"
                      Grid.Column="1"
                      Height="30"
                      Margin="0,0,0,12"
                      ItemsSource="{Binding ResultOptions}"
                      SelectedItem="{Binding SelectedResult}"
                      DisplayMemberPath="DisplayName"
                      IsEnabled="{Binding IsEditMode}" />

            <TextBlock Grid.Row="5"
                       Text="Примечание:"
                       Margin="0,7,15,0" />
            <TextBox Grid.Row="5"
                     Grid.Column="1"
                     MinHeight="100"
                     MaxLength="1000"
                     Padding="6"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Text="{Binding Note,
                            UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <TextBlock Grid.Row="3"
                   Text="{Binding ErrorMessage}"
                   Foreground="DarkRed"
                   TextWrapping="Wrap"
                   Margin="0,15,0,0" />

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="Отмена"
                    Command="{Binding CancelCommand}"
                    MinWidth="100"
                    Padding="16,6"
                    Margin="0,0,10,0" />

            <Button Content="{Binding SaveButtonText}"
                    Command="{Binding SaveCommand}"
                    MinWidth="100"
                    Padding="16,6" />
        </StackPanel>
    </Grid>
</Page>
