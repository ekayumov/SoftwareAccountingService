<Page x:Class="SoftwareAccountingService.Wpf.Presentation.Views.InspectionObjectsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Объекты проверки">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Наименование"/>
                <TextBox Text="{Binding SearchText,
                                UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Margin="0,0,10,0">
                <TextBlock Text="Тип"/>
                <ComboBox ItemsSource="{Binding TypeOptions}"
                          SelectedItem="{Binding SelectedType}"
                          DisplayMemberPath="DisplayName"/>
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Margin="0,0,10,0">
                <TextBlock Text="Результат"/>
                <ComboBox ItemsSource="{Binding ResultOptions}"
                          SelectedItem="{Binding SelectedResult}"
                          DisplayMemberPath="DisplayName"/>
            </StackPanel>

            <Button Grid.Column="3"
                    Content="Поиск"
                    Command="{Binding SearchCommand}"
                    Margin="0,18,10,0"
                    Padding="20,5"/>

            <Button Grid.Column="4"
                    Content="Новый объект"
                    Command="{Binding OpenCreateFormCommand}"
                    Margin="0,18,0,0"
                    Padding="20,5"/>
        </Grid>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding InspectionObjects}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Наименование"
                                    Binding="{Binding Name}"
                                    Width="*"/>

                <DataGridTextColumn Header="Версия"
                                    Binding="{Binding Version}"
                                    Width="100"/>

                <DataGridTextColumn Header="Тип"
                                    Binding="{Binding Type}"
                                    Width="100"/>

                <DataGridTextColumn Header="Дата получения"
                                    Binding="{Binding ReceivedDate,
                                              StringFormat=dd.MM.yyyy}"
                                    Width="130"/>

                <DataGridTextColumn Header="Результат"
                                    Binding="{Binding Result}"
                                    Width="140"/>

                <DataGridTextColumn Header="Примечание"
                                    Binding="{Binding Note}"
                                    Width="*"/>

                <DataGridTemplateColumn Header=""
                                        Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Редактировать"
                                    CommandParameter="{Binding Id}"
                                    Command="{Binding DataContext.OpenEditFormCommand,
                                        RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2"
                   Text="{Binding ErrorMessage}"
                   Foreground="Red"
                   Margin="0,10,0,0"/>
    </Grid>
</Page>